#!/bin/busybox sh
# dn42-login —— Login daemon aligned with server authoritative API

if [ -f /etc/dn42-lib.sh ]; then
  . /etc/dn42-lib.sh
elif [ -f "${0%/*}/../etc/dn42-lib.sh" ]; then
  . "${0%/*}/../etc/dn42-lib.sh"
elif [ -f "cli-src/etc/dn42-lib.sh" ]; then
  . "cli-src/etc/dn42-lib.sh"
fi

if ! command -v is_valid_asn_format >/dev/null 2>&1; then
  if [ -f /lib/rules.sh ]; then
    . /lib/rules.sh
  elif [ -f "${0%/*}/../lib/rules.sh" ]; then
    . "${0%/*}/../lib/rules.sh"
  elif [ -f "cli-src/lib/rules.sh" ]; then
    . "cli-src/lib/rules.sh"
  fi
fi

if ! command -v is_valid_asn_format >/dev/null 2>&1; then
  normalize_asn() {
    _asn="${1#[aA][sS]}"
    _asn="${_asn%% }"
    _asn="${_asn## }"
    echo "$_asn"
  }
  is_valid_asn_format() {
    _val="$(normalize_asn "$1")"
    case "$_val" in
      ''|*[!0-9]*) return 1 ;;
    esac
    [ "$_val" = "0" ] && return 1
    [ "${#_val}" -gt 10 ] && return 1
    if [ "${#_val}" -eq 10 ]; then
      if [ "$_val" \> "4294967295" ]; then
        return 1
      fi
    fi
    return 0
  }
fi

trap '' INT

# ---------- Shell Initialization ----------
enter_shell() {
  local asn="$1"
  local disp clean id_resp an mnt
  disp="AS$asn"
  clean=$(echo "$asn" | tr -cd '0-9')
  # Resolve identity display name: MNT simplified (AKIRA-MNT -> akira)
  id_resp=$(api_get "/api/auth/me")
  if echo "$id_resp" | grep -q '"success":true'; then
    # Identity display name: mntner simplified (AKI001-MNT -> aki001)
    mnt=$(json_field "$id_resp" mnt)
    if [ -n "$mnt" ]; then
      disp="$mnt"
    else
      an=$(json_field "$id_resp" asName)
      if [ -n "$an" ]; then
        mnt=$(echo "$an" | tr '[:upper:]' '[:lower:]' | sed 's/-mnt$//; s/-dn42$//')
        [ -n "$mnt" ] && disp="$mnt"
      fi
    fi
  fi
  echo ""
  echo -e "\033[32mSession initialized for $asn.\033[0m"
  echo ""
  printf "\033[90m===============================================================================\033[0m\n"
  echo -e "\033[1mAkiLab DN42 Peering Gateway - Active Session: \033[92m$asn\033[0m"
  printf "\033[90m-------------------------------------------------------------------------------\033[0m\n"
  echo "  peer new          Request a new peering session"
  echo "  peer ls / peer rm List / revoke my peering sessions"
  echo "  nodes / whois     AkiLab node matrix / DN42 registry"
  echo "  whoami / logout   Current identity / sign out"
  echo "  help              Full command list"
  echo -e "  \033[90mCopy: Ctrl+C (select) · Paste: Ctrl+V · Interrupt: Ctrl+C (no select)\033[0m"
  printf "\033[90m===============================================================================\033[0m\n\n"
  export PS1="\[\033[32m\]peer@$disp\[\033[0m\]:\[\033[36m\]~\[\033[0m\]# "
  export HOME=/root
  cd /root
  stty sane 2>/dev/null || stty icanon echo isig 2>/dev/null
  trap - INT
  exec /bin/sh -l
}

# ---------- Auto Login via Persistent Token ----------
try_autologin() {
  local token saved_asn resp me_asn
  token=$(cat /mnt/persist/.dn42/token 2>/dev/null)
  [ -z "$token" ] && return 1
  saved_asn=$(cat /mnt/persist/.dn42/asn 2>/dev/null)

  resp=$(wget -q -T 15 -O - --header="Authorization: Bearer $token" "$API_BASE/api/auth/me" 2>/dev/null || curl -s -m 15 -H "Authorization: Bearer $token" "$API_BASE/api/auth/me" 2>/dev/null)
  if ! echo "$resp" | grep -q '"success":true'; then
    rm -f /mnt/persist/.dn42/token /mnt/persist/.dn42/asn 2>/dev/null
    return 1
  fi

  me_asn=$(json_field "$resp" asn)
  [ -z "$me_asn" ] && me_asn="$saved_asn"

  echo "$token" > /tmp/dn42_token
  echo "$me_asn" > /tmp/dn42_asn
  enter_shell "$me_asn"
  return 0
}

save_token() {
  local token="$1" asn="$2" remember="$3"
  echo "$token" > /tmp/dn42_token
  echo "$asn" > /tmp/dn42_asn
  if [ "$remember" = "true" ]; then
    mkdir -p /mnt/persist/.dn42 2>/dev/null
    echo "$token" > /mnt/persist/.dn42/token 2>/dev/null
    echo "$asn" > /mnt/persist/.dn42/asn 2>/dev/null
  fi
}

do_password_login() {
  local clean="$1" remember="$2" pwd resp token user_asn
  echo -e "\033[90m(Enter password, type 'mail' for Email OTP, 'ssh' for SSH key, or 'q' to cancel)\033[0m"
  while true; do
    printf "\033[33mPassword for %s\033[0m: " "$clean"
    read_line_edit pwd -s

    if [ "$pwd" = "q" ] || [ "$pwd" = "quit" ]; then
      echo -e "\033[90mCancelled.\033[0m"
      return 3
    fi
    if [ "$pwd" = "ssh" ] || [ "$pwd" = "SSH" ]; then
      return 2
    fi
    if [ "$pwd" = "mail" ] || [ "$pwd" = "MAIL" ] || [ "$pwd" = "email" ] || [ "$pwd" = "EMAIL" ]; then
      return 4
    fi
    if [ -z "$pwd" ]; then
      echo -e "\033[90m(Password cannot be empty. Type 'mail' or 'ssh' to verify, or 'q' to cancel)\033[0m"
      continue
    fi

    echo -e "\033[90mVerifying password credentials...\033[0m"
    resp=$(api_post "/api/auth/login-password" "{\"asn\":\"$clean\",\"password\":\"$pwd\",\"rememberMe\":$remember}")
    if echo "$resp" | grep -q '"success":true'; then
      token=$(json_field "$resp" token)
      user_asn=$(json_field "$resp" asn)
      [ -z "$user_asn" ] && user_asn="$clean"
      save_token "$token" "$user_asn" "$remember"
      echo -e "\033[32mAuthenticated via password. Welcome back.\033[0m"
      return 0
    fi

    echo -e "\033[31merror: $(json_field "$resp" message)\033[0m"
    echo -e "\033[90m(Type 'mail' for Email OTP, 'ssh' for SSH key, or retry password)\033[0m"
  done
}

do_set_password() {
  local clean="$1" new_pwd confirm_pwd resp
  while true; do
    printf "\033[33mNew password (min 8 chars, 'q' to skip)\033[0m: "
    read_line_edit new_pwd -s
    flush_after_input
    if [ "$new_pwd" = "q" ] || [ -z "$new_pwd" ]; then
      echo -e "\033[90mPassword setup skipped.\033[0m"
      return 0
    fi
    if [ "${#new_pwd}" -lt 8 ]; then
      echo -e "\033[31merror: Password must be at least 8 characters.\033[0m"
      continue
    fi
    printf "\033[33mConfirm new password\033[0m: "
    read_line_edit confirm_pwd -s
    flush_after_input
    if [ "$new_pwd" != "$confirm_pwd" ]; then
      echo -e "\033[31merror: Passwords do not match. Please try again.\033[0m"
      continue
    fi

    resp=$(api_post "/api/auth/set-password" "{\"password\":\"$new_pwd\"}")
    if echo "$resp" | grep -q '"success":true'; then
      echo -e "\033[32mPassword saved successfully! You can use this password for fast logins next time.\033[0m"
      return 0
    else
      echo -e "\033[31merror: $(json_field "$resp" message)\033[0m"
      return 1
    fi
  done
}

do_email_login() {
  local clean="$1" remember="$2" target_email="$3" email_src="$4"
  local send_resp verify_resp code token user_asn err_msg

  echo -e "\033[90mSending verification code to $target_email...\033[0m"
  send_resp=$(api_post "/api/auth/email/send" "{\"asn\":\"$clean\"}")
  if ! echo "$send_resp" | grep -q '"success":true'; then
    err_msg=$(json_field "$send_resp" message)
    [ -z "$err_msg" ] && err_msg="Failed to send verification code"
    echo -e "\033[31merror: $err_msg\033[0m"
    return 1
  fi

  echo ""
  echo -e "\033[32mVerification code sent to \033[1m$target_email\033[0;32m.\033[0m"
  echo -e "\033[93mNotice: If not received, please check your Spam / Junk folder.\033[0m"
  echo -e "\033[90m(The code is valid for 10 minutes. 30s cooldown before resending)\033[0m"
  echo ""

  while true; do
    printf "\033[33mEnter 6-digit code (type 'r' to resend, 'q' to cancel)\033[0m: "
    stty icanon echo isig 2>/dev/null
    code=""
    if ! read -r code; then
      code="q"
    fi
    clean_raw=$(printf '%s' "$code" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    if [ "$clean_raw" = "q" ] || [ "$clean_raw" = "quit" ]; then
      echo -e "\033[90mCancelled.\033[0m"
      return 1
    fi

    if [ "$clean_raw" = "r" ] || [ "$clean_raw" = "resend" ]; then
      echo -e "\033[90mRequesting new verification code...\033[0m"
      send_resp=$(api_post "/api/auth/email/send" "{\"asn\":\"$clean\"}")
      if echo "$send_resp" | grep -q '"success":true'; then
        echo -e "\033[32mA new verification code has been sent to $target_email.\033[0m"
        echo -e "\033[93mNotice: If not received, please check your Spam / Junk folder.\033[0m"
      else
        err_msg=$(json_field "$send_resp" message)
        [ -z "$err_msg" ] && err_msg="Failed to resend code"
        echo -e "\033[31merror: $err_msg\033[0m"
      fi
      continue
    fi

    code=$(printf '%s' "$clean_raw" | tr -d ' \t')

    # Clean non-digits
    code=$(echo "$code" | tr -cd '0-9')
    if [ "${#code}" -ne 6 ]; then
      echo -e "\033[31merror: Please enter a 6-digit numeric code.\033[0m"
      continue
    fi

    echo -e "\033[90mVerifying code with gateway...\033[0m"
    verify_resp=$(api_post "/api/auth/email/verify" "{\"asn\":\"$clean\",\"code\":\"$code\",\"rememberMe\":$remember}")
    if echo "$verify_resp" | grep -q '"success":true'; then
      token=$(json_field "$verify_resp" token)
      user_asn=$(json_field "$verify_resp" asn)
      [ -z "$user_asn" ] && user_asn="$clean"
      save_token "$token" "$user_asn" "$remember"
      echo -e "\033[32mVerified via Email OTP. Welcome AS$user_asn.\033[0m"
      return 0
    fi

    err_msg=$(json_field "$verify_resp" message)
    [ -z "$err_msg" ] && err_msg="Verification code invalid or expired"
    echo -e "\033[31merror: $err_msg\033[0m"
  done
}

do_ssh_login() {
  local clean="$1" remember="$2" resp chal_text unix_cmd ps_cmd sig line token user_asn
  echo -e "\033[90mRequesting challenge for AS$clean...\033[0m"
  resp=$(api_get "/api/auth/challenge?asn=$clean")

  if ! echo "$resp" | grep -q '"success":true'; then
    echo -e "\033[31merror: $(json_field "$resp" message)\033[0m"
    return 1
  fi

  chal_text=$(json_field "$resp" challengeText)
  unix_cmd=$(json_field "$resp" commandLinux)
  [ -z "$unix_cmd" ] && unix_cmd=$(json_field "$resp" unixCommand)
  ps_cmd=$(json_field "$resp" commandPowershell)
  [ -z "$ps_cmd" ] && ps_cmd=$(json_field "$resp" powershellCommand)

  echo ""
  echo -e "\033[90mChallenge: \033[33m$chal_text\033[0m"
  echo -e "\033[90mRun ONE of the commands below on YOUR OWN machine (not in this terminal).\033[0m"
  echo ""
  if [ -n "$ps_cmd" ]; then
    echo -e "\033[1m[Windows / PowerShell]\033[0m"
    printf '  %s\n' "$ps_cmd"
    echo ""
  fi
  if [ -n "$unix_cmd" ]; then
    echo -e "\033[1m[Linux / macOS / Git Bash]\033[0m"
    printf '  %s\n' "$unix_cmd"
    echo ""
  fi
  echo -e "\033[90mThen paste the signature block below (type q to cancel):\033[0m"

  while true; do
    echo ""
    printf "\033[33msignature\033[0m: "
    sig=""
    while true; do
      if ! read -r line; then
        if [ -n "$line" ]; then
          line=$(printf '%s' "$line" | tr -d '\r')
          if [ -z "$sig" ]; then
            sig="$line"
          else
            sig="$sig\\n$line"
          fi
          if echo "$line" | grep -q -- "END SSH SIGNATURE"; then
            break
          fi
        fi
        if [ -n "$sig" ]; then break; fi
        continue
      fi
      [ -z "$line" ] && continue
      if [ -z "$sig" ] && { [ "$line" = "q" ] || [ "$line" = "quit" ] || [ "$line" = "abort" ]; }; then
        echo -e "\033[90mSigning cancelled.\033[0m"
        return 1
      fi
      line=$(printf '%s' "$line" | tr -d '\r')
      if [ -z "$sig" ]; then
        sig="$line"
      else
        sig="$sig\\n$line"
      fi
      if echo "$line" | grep -q -- "END SSH SIGNATURE"; then
        break
      fi
    done
    flush_after_input

    if [ -z "$sig" ]; then
      echo -e "\033[31merror: Signature cannot be empty.\033[0m"
      continue
    fi

    echo -e "\033[90mVerifying cryptographic signature with gateway...\033[0m"
    payload="{\"asn\":$clean,\"challengeText\":\"$chal_text\",\"signature\":\"$sig\",\"rememberMe\":$remember}"
    resp=$(api_post "/api/auth/verify-ssh" "$payload")
    if echo "$resp" | grep -q '"success":true'; then
      token=$(json_field "$resp" token)
      user_asn=$(json_field "$resp" asn)
      [ -z "$user_asn" ] && user_asn="$clean"
      save_token "$token" "$user_asn" "$remember"
      echo -e "\033[32mVerified. Welcome back.\033[0m"
      return 0
    fi

    echo -e "\033[31merror: $(json_field "$resp" message)\033[0m"
  done
}

# ---------- Main Login Loop ----------
main() {
  try_autologin && return 0

  clear
  echo ""
  echo -e "\033[90mLinux aki-lab 6.1.0-wasm32 (tty1)\033[0m"
  echo ""
  cat /etc/banner.txt 2>/dev/null || sh /etc/banner.sh
  printf '\n\n'
  echo -e " * Gateway:         \033[33mAkiLab Networks AS4242423143\033[0m"
  echo -e " * Routing Policy:  \033[32mOpen / MP-BGP (Extended Next Hop)\033[0m"
  echo -e " * Access Control:  \033[35mMandatory DN42 Cryptographic Verification\033[0m"
  printf "\033[90m-------------------------------------------------------------------------------\033[0m\n"

  echo -e "\033[90mCopy: Ctrl+C (select) · Paste: Ctrl+V · Interrupt: Ctrl+C (no select)\033[0m"

  local asn_in clean remember rem_in ret
  local check_resp err_msg has_pwd as_name person_name primary_email email_source primary_ssh_key key_preview method_choice set_pwd_ans
  while true; do
    echo ""
    printf "\033[33mlogin (Your DN42 ASN)\033[0m: "
    read_line_edit asn_in
    flush_after_input

    [ -z "$asn_in" ] && continue

    if ! is_valid_asn_format "$asn_in"; then
      echo -e "\033[31merror: Invalid ASN format. ASN must be a valid number (e.g. 4242423143, AS4242423143, or public ASN).\033[0m"
      continue
    fi

    clean=$(normalize_asn "$asn_in")

    printf "\033[33mRemember login for 30 days? [Y/n]\033[0m: "
    read_line_edit rem_in
    flush_after_input
    if [ "$rem_in" = "n" ] || [ "$rem_in" = "N" ]; then
      remember="false"
    else
      remember="true"
    fi

    # Authoritative check for registration, password status, and WHOIS credentials
    check_resp=$(api_get "/api/auth/check?asn=$clean")
    if ! echo "$check_resp" | grep -q '"success":true'; then
      err_msg=$(json_field "$check_resp" message)
      [ -z "$err_msg" ] && err_msg="ASN verification failed"
      echo -e "\033[31merror: $err_msg\033[0m"
      continue
    fi

    has_pwd=$(json_field "$check_resp" hasPassword)
    as_name=$(json_field "$check_resp" asName)
    person_name=$(json_field "$check_resp" personName)
    primary_email=$(json_field "$check_resp" primaryEmail)
    email_source=$(json_field "$check_resp" emailSource)
    primary_ssh_key=$(json_field "$check_resp" primarySshKey)

    if [ "$has_pwd" = "true" ]; then
      do_password_login "$clean" "$remember"
      ret=$?
      if [ $ret -eq 0 ]; then
        enter_shell "$clean"
        return 0
      fi
      # ret 3 = cancelled (Ctrl+C / 'q' at password), back to login prompt
      [ $ret -eq 3 ] && continue

      if [ $ret -eq 4 ]; then
        # user typed 'mail'
        if [ -z "$primary_email" ]; then
          echo -e "\033[31merror: No registered email address found in WHOIS for AS$clean.\033[0m"
          continue
        fi
        do_email_login "$clean" "$remember" "$primary_email" "$email_source"
        if [ $? -eq 0 ]; then
          enter_shell "$clean"
          return 0
        fi
        continue
      fi

      if [ $ret -eq 2 ]; then
        # user typed 'ssh'
        do_ssh_login "$clean" "$remember"
        if [ $? -eq 0 ]; then
          enter_shell "$clean"
          return 0
        fi
        continue
      fi
    else
      # First time login (no password set) -> Show method options directly
      echo ""
      if [ -n "$person_name" ]; then
        echo -e "\033[1;36mHello, $person_name (AS$clean)!\033[0m"
      else
        echo -e "\033[1;36mHello, AS$clean!\033[0m"
      fi
      echo -e "\033[90mFirst-time login detected. Please select an identity verification method:\033[0m"
      echo ""
      if [ -n "$primary_email" ]; then
        echo -e "  \033[1;33m1)\033[0m Email OTP Verification   \033[90m-> $primary_email ($email_source)\033[0m"
      else
        echo -e "  \033[90m1) Email OTP Verification   -> (No email found in WHOIS)\033[0m"
      fi
      if [ -n "$primary_ssh_key" ]; then
        key_preview="$primary_ssh_key"
        if [ "${#key_preview}" -gt 45 ]; then
          key_preview="$(printf '%s' "$key_preview" | cut -c 1-45)..."
        fi
        echo -e "  \033[1;33m2)\033[0m SSH Key Signature        \033[90m-> $key_preview\033[0m"
      else
        echo -e "  \033[90m2) SSH Key Signature        -> (No SSH key found in WHOIS)\033[0m"
      fi
      echo ""

      while true; do
        printf "\033[33mSelect verification method [1/2, or 'q' to cancel]\033[0m: "
        read_line_edit method_choice
        flush_after_input

        if [ "$method_choice" = "q" ] || [ "$method_choice" = "quit" ]; then
          echo -e "\033[90mCancelled.\033[0m"
          break
        fi

        if [ "$method_choice" = "1" ] || [ "$method_choice" = "mail" ]; then
          if [ -z "$primary_email" ]; then
            echo -e "\033[31merror: No registered email address found in WHOIS for AS$clean.\033[0m"
            continue
          fi
          do_email_login "$clean" "$remember" "$primary_email" "$email_source"
          if [ $? -eq 0 ]; then
            echo ""
            printf "\033[33mSet a password for future fast logins? [y/N]\033[0m: "
            set_pwd_ans=""
            read_line_edit set_pwd_ans
            flush_after_input
            if [ "$set_pwd_ans" = "y" ] || [ "$set_pwd_ans" = "Y" ]; then
              do_set_password "$clean"
            fi
            enter_shell "$clean"
            return 0
          fi
          break
        elif [ "$method_choice" = "2" ] || [ "$method_choice" = "ssh" ]; then
          do_ssh_login "$clean" "$remember"
          if [ $? -eq 0 ]; then
            echo ""
            printf "\033[33mSet a password for future fast logins? [y/N]\033[0m: "
            set_pwd_ans=""
            read_line_edit set_pwd_ans
            flush_after_input
            if [ "$set_pwd_ans" = "y" ] || [ "$set_pwd_ans" = "Y" ]; then
              do_set_password "$clean"
            fi
            enter_shell "$clean"
            return 0
          fi
          break
        else
          echo -e "\033[90m(Please type '1' for Email OTP, '2' for SSH, or 'q' to cancel)\033[0m"
        fi
      done
    fi
  done
}

main
