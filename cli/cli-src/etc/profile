# /etc/profile —— Loaded on ash interactive shell startup via $ENV
export TERM=xterm-256color
export EDITOR=nano
help() { /bin/help "$@"; }
command -v api_get >/dev/null 2>&1 || . /etc/dn42-lib.sh

# ---- boot warm-up (one-time cost at login, speeds up every later action) ----
# 1. Page-cache hot binaries/scripts so exec() never re-reads them from disk
cat /bin/busybox /bin/nano /bin/peer /bin/nodes /bin/passwd /bin/whois /bin/lg /etc/dn42-lib.sh /lib/rules.sh /etc/peer_template > /dev/null 2>&1
# 2. Warm the fork/exec path (first fork pays page-table init, later ones are cheap)
( true; true; true ) 2>/dev/null
# 3. Pre-fetch node metadata in background so the first 'peer new' skips the network round-trip
( api_get /api/network-meta > /tmp/dn42_meta 2>/dev/null ) &
