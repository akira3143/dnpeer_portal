#!/bin/busybox sh
# help —— Quick command reference

echo -e "Available commands:"
printf "  \033[32m%-24s\033[0m- %s\n" "peer new" "Request a new peering session"
printf "  \033[32m%-24s\033[0m- %s\n" "peer ls" "List my peering sessions & status"
printf "  \033[32m%-24s\033[0m- %s\n" "peer rm <ID>" "Revoke a session and release its port"
printf "  \033[32m%-24s\033[0m- %s\n" "nodes" "Show the AkiLab global node matrix"
printf "  \033[32m%-24s\033[0m- %s\n" "whois <ASN>" "Query the DN42 registry"
printf "  \033[32m%-24s\033[0m- %s\n" "whoami" "Show current identity"
printf "  \033[32m%-24s\033[0m- %s\n" "passwd" "Change login password"
printf "  \033[32m%-24s\033[0m- %s\n" "logout" "Sign out"
printf "  \033[32m%-24s\033[0m- %s\n" "lg route <IP|ASN> [node]" "BGP routing table & AS-Path"
printf "  \033[32m%-24s\033[0m- %s\n" "lg bgp [node]" "BGP session state (protocols)"
printf "  \033[32m%-24s\033[0m- %s\n" "lg status [node]" "BIRD daemon status"
printf "  \033[32m%-24s\033[0m- %s\n" "lg ping <IP> [node]" "Ping from specified node"
printf "  \033[32m%-24s\033[0m- %s\n" "lg trace <IP> [node]" "Remote traceroute from node"
printf "  \033[32m%-24s\033[0m- " "startx"
printf "%b\n" "Launch the Web GUI \033[90m(beta)\033[0m"
printf "  \033[90m%-24s\033[0m- %s\n" "dmesg / uname -a" "Kernel info (real Linux commands)"
