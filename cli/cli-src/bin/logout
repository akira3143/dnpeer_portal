#!/bin/busybox sh
# logout —— 退出登录（同时清除持久化会话，防止下次自动登录）

rm -f /tmp/dn42_token /tmp/dn42_asn
rm -f /mnt/persist/.dn42/token /mnt/persist/.dn42/asn 2>/dev/null
# Signal gateway to clear the mirrored localStorage token (prevents re-login on refresh)
api_get "/api/auth/logout" > /dev/null 2>&1
echo -e "\033[32m Signed out.\033[0m"
exec /sbin/dn42-login
