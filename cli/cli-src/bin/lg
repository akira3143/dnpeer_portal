#!/bin/busybox sh
# lg —— BIRD 2.x Looking Glass (aligned with POST /api/looking-glass)

if [ -f /etc/dn42-lib.sh ]; then
  . /etc/dn42-lib.sh
elif [ -f "${0%/*}/../etc/dn42-lib.sh" ]; then
  . "${0%/*}/../etc/dn42-lib.sh"
elif [ -f "cli-src/etc/dn42-lib.sh" ]; then
  . "cli-src/etc/dn42-lib.sh"
fi

cmd="$1"
target="$2"
node="$3"

if [ -z "$cmd" ] || [ "$cmd" = "help" ]; then
  echo -e "\033[33mUsage: lg <route|bgp|status|ping|trace> [target] [node]\033[0m"
  echo -e "\033[90mFull details: run 'help'\033[0m"
  exit 0
fi

if [ "$cmd" = "bgp" ] || [ "$cmd" = "protocols" ]; then cmd="protocols"; fi
if [ "$cmd" = "trace" ] || [ "$cmd" = "traceroute" ]; then cmd="traceroute"; fi
if [ -z "$node" ]; then
  if [ -s /tmp/dn42_nodes ]; then
    node=$(head -n 1 /tmp/dn42_nodes | cut -d'|' -f1)
  fi
  [ -z "$node" ] && node="JP-7"
fi

echo -e "\033[90mExecuting Looking Glass query on \033[36m$node\033[90m: \033[32m$cmd $target\033[0m..."

payload="{\"nodeId\":\"$node\",\"commandType\":\"$cmd\",\"target\":\"$target\"}"
resp=$(api_post "/api/looking-glass" "$payload")

if [ -z "$resp" ]; then
  printf '\033[31merror: Looking Glass query failed or timed out.\033[0m\n'
  exit 1
fi

if ! echo "$resp" | grep -q '"success":true'; then
  err_msg=$(json_field "$resp" message)
  [ -z "$err_msg" ] && err_msg=$(echo "$resp" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
  [ -z "$err_msg" ] && err_msg="Looking Glass query failed."
  printf '\033[31merror: %s\033[0m\n' "$err_msg"
  exit 1
fi

echo ""
out=$(json_field "$resp" output)
echo "$out" | sed 's/\\n/\n/g; s/\\r//g; s/\\"/"/g; s/\\\\/\\/g; s/\\t/\t/g'
echo ""
