#!/bin/busybox sh
# lg —— BIRD 2.x Looking Glass (aligned with POST /api/looking-glass)

if [ -f /etc/dn42-lib.sh ]; then
  . /etc/dn42-lib.sh
elif [ -f "${0%/*}/../etc/dn42-lib.sh" ]; then
  . "${0%/*}/../etc/dn42-lib.sh"
elif [ -f "cli-src/etc/dn42-lib.sh" ]; then
  . "cli-src/etc/dn42-lib.sh"
fi

cmd="$1"
target="$2"
node="$3"

if [ -z "$cmd" ] || [ "$cmd" = "help" ]; then
  echo -e "\033[36m------------------ [AKILAB BIRD 2.x LOOKING GLASS] ------------------\033[0m"
  echo -e "\033[90mPowered by bird-lg-go / bird-lgproxy protocol\033[0m"
  echo ""
  echo -e "\033[1mUsage:\033[0m  lg <command> [target] [node_id]"
  echo ""
  echo -e "  \033[32mlg route <IP/CIDR/ASN> [node]\033[0m   Query BGP routing table & AS-Path"
  echo -e "  \033[32mlg bgp [peer] [node]\033[0m              Query BGP session state (protocols)"
  echo -e "  \033[32mlg status [node]\033[0m                Query BIRD daemon status"
  echo -e "  \033[32mlg ping <IP> [node]\033[0m             Remote ICMP ping from target node"
  echo -e "  \033[32mlg trace <IP> [node]\033[0m            Remote traceroute from target node"
  echo -e "\033[36m---------------------------------------------------------------------\033[0m"
  exit 0
fi

if [ "$cmd" = "bgp" ] || [ "$cmd" = "protocols" ]; then cmd="protocols"; fi
if [ "$cmd" = "trace" ] || [ "$cmd" = "traceroute" ]; then cmd="traceroute"; fi
[ -z "$node" ] && node="JP-TYO-1"

echo -e "\033[90mExecuting Looking Glass query on \033[36m$node\033[90m: \033[32m$cmd $target\033[0m..."

payload="{\"nodeId\":\"$node\",\"commandType\":\"$cmd\",\"target\":\"$target\"}"
resp=$(api_post "/api/looking-glass" "$payload")

if [ -z "$resp" ]; then
  echo -e "\033[31merror: Looking Glass query failed or timed out.\033[0m"
  exit 1
fi

echo ""
out=$(echo "$resp" | sed -n 's/.*"output":"\(.*\)","durationMs".*/\1/p')
if [ -z "$out" ]; then
  out=$(echo "$resp" | sed -n 's/.*"output":"\(.*\)".*/\1/p')
fi
echo "$out" | sed 's/\\n/\n/g; s/\\r//g; s/\\"/"/g; s/\\\\/\\/g; s/\\t/\t/g'
echo ""
