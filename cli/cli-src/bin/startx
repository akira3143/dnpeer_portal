#!/bin/busybox sh
# startx —— Launch Web GUI with terminal animation and automatic redirect

if [ -f /etc/dn42-lib.sh ]; then
  . /etc/dn42-lib.sh
elif [ -f "${0%/*}/../etc/dn42-lib.sh" ]; then
  . "${0%/*}/../etc/dn42-lib.sh"
elif [ -f "cli-src/etc/dn42-lib.sh" ]; then
  . "cli-src/etc/dn42-lib.sh"
fi

meta=$(api_get "/api/network-meta")
gui_path=$(json_field "$meta" guiPath)
[ -z "$gui_path" ] && gui_path="/gui/"

# Ensure trailing slash
case "$gui_path" in
  */) ;;
  *) gui_path="$gui_path/" ;;
esac

# 1. Single-line progress bar animation (2s duration, 30 chars width)
total_steps=15
width=30

for step in $(seq 1 $total_steps); do
  pct=$(( (step * 100) / total_steps ))
  filled=$(( (step * width) / total_steps ))
  unfilled=$(( width - filled ))

  bar_filled=""
  j=0
  while [ $j -lt $filled ]; do
    bar_filled="${bar_filled}█"
    j=$((j + 1))
  done

  bar_empty=""
  j=0
  while [ $j -lt $unfilled ]; do
    bar_empty="${bar_empty}░"
    j=$((j + 1))
  done

  printf "\r\033[36mStarting graphical interface...\033[0m [\033[32m%s\033[90m%s\033[0m] %3d%%" "$bar_filled" "$bar_empty" "$pct"
  usleep 100000 2>/dev/null || sleep 0.1 2>/dev/null || :
done

printf "\n\033[90mLaunching Web GUI at %s...\033[0m\n" "$gui_path"

# 2. Trigger OSC jump sequences
printf "\033]1337;OpenUrl=%s\007" "$gui_path"
printf "\033]50;AgyJump=%s\007" "$gui_path"
