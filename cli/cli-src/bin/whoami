#!/bin/busybox sh
# whoami —— 当前登录身份（实时校验 token，对齐 GET /api/auth/me）

. /etc/dn42-lib.sh

token=$(dn42_token)
if [ -z "$token" ]; then
  echo -e "\033[33mUnauthenticated guest session.\033[0m"
  exit 0
fi

resp=$(wget -q -T 15 -O - --header="Authorization: Bearer $token" "$API_BASE/api/auth/me" 2>/dev/null)
if ! echo "$resp" | grep -q '"success":true'; then
  echo -e "\033[31merror: Token invalid, please login again.\033[0m"
  exit 1
fi

asn=$(json_field "$resp" asn)
auth=$(json_field "$resp" authMethod)
admin=$(json_bool "$resp" isAdmin)
exp_ms=$(json_num "$resp" expiresAt)
as_name=$(json_field "$resp" asName)
role=$(json_field "$resp" role)

case "$auth" in
  ssh_signature) auth_str="Verified (SSH signature)" ;;
  password) auth_str="Verified (password)" ;;
  admin_master_key) auth_str="Admin Master Key" ;;
  *) auth_str="${auth:-unknown}" ;;
esac

echo -e "\033[1mActive DN42 Session:\033[0m"
echo -e "  ASN:        \033[92m${asn:-AS$(dn42_asn)}\033[0m"
[ -n "$as_name" ] && echo -e "  Name:       \033[36m$as_name\033[0m"
echo -e "  Identity:   \033[32m$auth_str\033[0m"
if [ "$admin" = "true" ]; then
  echo -e "  Role:       \033[35m${role:-admin}\033[0m"
fi
if [ -n "$exp_ms" ]; then
  exp_s=$((exp_ms / 1000))
  exp_date=$(date -d "@$exp_s" '+%Y-%m-%d' 2>/dev/null)
  echo -e "  Token:      \033[90mvalid (expires ${exp_date:-in 7d})\033[0m"
else
  echo -e "  Token:      \033[90mvalid\033[0m"
fi
