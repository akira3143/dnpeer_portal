#!/bin/busybox sh
# nodes —— AkiLab global PoP node matrix & live probe statuses

if [ -f /etc/dn42-lib.sh ]; then
  . /etc/dn42-lib.sh
elif [ -f "${0%/*}/../etc/dn42-lib.sh" ]; then
  . "${0%/*}/../etc/dn42-lib.sh"
elif [ -f "cli-src/etc/dn42-lib.sh" ]; then
  . "cli-src/etc/dn42-lib.sh"
fi

echo -e "\033[90mQuerying AkiLab Global PoP Nodes & Live Probes...\033[0m"

meta=$(api_get "/api/network-meta")
if ! echo "$meta" | grep -q '"success":true'; then
  echo -e "\033[31merror: Cannot fetch node matrix.\033[0m"
  exit 1
fi
probes=$(api_get "/api/probe/status")

echo ""
echo -e "\033[1mAkiLab Networks (AS4242423143) Global PoP Node Matrix\033[0m"
echo -e "\033[90mPolicy: Open / MP-BGP (ENH) | Port Formula: 20000 + (ASN % 10000)\033[0m"
echo ""

# Compute dynamic column widths from real data (single awk pass)
max_name=9; max_end=8
set -- $(echo "$meta" | sed 's/},{/}\n{/g' | grep '"endpointDomain"' | awk -F'"' '
  {
    for (i=1;i<=NF;i++) {
      if ($i=="name") { v=$(i+2); if (length(v)>mn) mn=length(v) }
      if ($i=="endpointDomain") { v=$(i+2); if (length(v)>me) me=length(v) }
    }
  }
  END { print mn+0, me+0 }')
[ -n "$1" ] && [ "$1" -gt 0 ] && max_name="$1"
[ -n "$2" ] && [ "$2" -gt 0 ] && max_end="$2"

printf "  %-3s %-8s %-*s %-*s %s\n" "#" "NODE" "$max_name" "NODE NAME" "$max_end" "ENDPOINT" "STATUS"
printf "\033[90m  %-3s %-8s %-*s %-*s %s\033[0m\n" "---" "--------" "$max_name" "$(printf '%*s' "$max_name" '' | tr ' ' '-')" "$max_end" "$(printf '%*s' "$max_end" '' | tr ' ' '-')" "------"

i=0
echo "$meta" | sed 's/},{/}\n{/g' | grep '"endpointDomain"' | while IFS= read -r line; do
  i=$((i + 1))
  nid=${line#*\"id\":\"}; nid=${nid%%\"*}
  nname=${line#*\"name\":\"}; nname=${nname%%\"*}
  nend=${line#*\"endpointDomain\":\"}; nend=${nend%%\"*}
  ncode=${line#*\"code\":\"}; ncode=${ncode%%\"*}
  nlat=""
  nup=""
  pblock=${probes#*\"$nid\":\{}
  [ "$pblock" = "$probes" ] && pblock=""
  if [ -z "$pblock" ] && [ -n "$ncode" ]; then
    pblock=${probes#*\"$ncode\":\{}
    [ "$pblock" = "$probes" ] && pblock=""
  fi
  if [ -n "$pblock" ]; then
    pblock=${pblock%%\}*}"}"
    nlat=${pblock#*\"latencyMs\":}; nlat=${nlat%%,*}; nlat=${nlat%%\}*}
    case "$pblock" in *\"online\":true*|*\"status\":\"online\"*) nup="1" ;; esac
  fi

  # Also check status directly from network-meta node object
  case "$line" in *\"status\":\"online\"*|*\"online\":true*) nup="1" ;; esac

  if [ "$nup" = "1" ]; then
    if [ -n "$nlat" ] && [ "$nlat" != "$pblock" ]; then
      status_str="\033[32m* online  ${nlat}ms\033[0m"
    else
      status_str="\033[32m* online\033[0m"
    fi
  else
    status_str="\033[90m- offline\033[0m"
  fi
  printf "  %-3s %-8s %-24s %-28s $status_str\n" "$i" "$nid" "$nname" "$nend"
done
echo ""
echo -e "\033[90mTo peer with a node, run: peer new\033[0m"
