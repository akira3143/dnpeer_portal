#!/bin/busybox sh
# whois —— DN42 Registry metadata query (aligned with GET /api/dn42-lookup)

if [ -f /etc/dn42-lib.sh ]; then
  . /etc/dn42-lib.sh
elif [ -f "${0%/*}/../etc/dn42-lib.sh" ]; then
  . "${0%/*}/../etc/dn42-lib.sh"
elif [ -f "cli-src/etc/dn42-lib.sh" ]; then
  . "cli-src/etc/dn42-lib.sh"
fi

query="$1"
if [ -z "$query" ]; then
  echo -e "\033[31merror: Usage: whois <ASN / Maintainer>\033[0m"
  exit 1
fi

clean_asn=$(echo "$query" | tr -cd '0-9')
echo -e "\033[90mQuerying DN42 Registry for \033[32m$query\033[90m...\033[0m"

resp=$(api_get "/api/dn42-lookup?asn=$clean_asn")
if [ -z "$resp" ]; then
  echo -e "\033[31merror: DN42 Registry query failed.\033[0m"
  exit 1
fi

if ! echo "$resp" | grep -q '"valid":true'; then
  err_msg=$(json_field "$resp" error)
  [ -z "$err_msg" ] && err_msg=$(echo "$resp" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')
  echo -e "\033[31merror: ${err_msg:-DN42 Registry query failed.}\033[0m"
  exit 1
fi

echo ""
echo -e "\033[1m------------------ [DN42 REGISTRY OBJECT: AS$clean_asn] ------------------\033[0m"
echo -e "aut-num:        \033[92mAS$clean_asn\033[0m"
as_name=$(json_field "$resp" asName)
[ -n "$as_name" ] && echo -e "as-name:        $as_name"
descr=$(json_field "$resp" descr)
[ -n "$descr" ] && echo -e "descr:          $descr"
mnt=$(json_field "$resp" maintainer)
[ -n "$mnt" ] && echo -e "mnt-by:         \033[36m$mnt\033[0m"
admin=$(json_field "$resp" adminContact)
[ -n "$admin" ] && echo -e "admin-c:        \033[33m$admin\033[0m"
echo -e "source:         DN42"
echo -e "\033[1m------------------------------------------------------------------------\033[0m"
