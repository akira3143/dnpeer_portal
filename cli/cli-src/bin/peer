#!/bin/busybox sh
# peer —— Peering session management (new / ls / rm)
# Uses nano editor + template + batch validation workflow (V1)

if [ -f /etc/dn42-lib.sh ]; then
  . /etc/dn42-lib.sh
elif [ -f "${0%/*}/../etc/dn42-lib.sh" ]; then
  . "${0%/*}/../etc/dn42-lib.sh"
elif [ -f "cli-src/etc/dn42-lib.sh" ]; then
  . "cli-src/etc/dn42-lib.sh"
fi

usage() {
  echo -e "\033[36mUsage:\033[0m"
  echo -e "  \033[32mpeer new [node#]\033[0m   Request a new peering session via editor"
  echo -e "  \033[32mpeer edit [n|node]\033[0m Edit an existing session (by number, node ID, or session ID)"
  echo -e "  \033[32mpeer ls\033[0m            List my peering sessions & status"
  echo -e "  \033[32mpeer rm <ID>\033[0m       Revoke a session and release its port"
}

# ---------- peer new (V1: nano editor + template) ----------
# ---------- ensure node matrix cache ----------
ensure_nodes() {
  [ -s /tmp/dn42_nodes ] && return 0
  local meta
  if [ -s /tmp/dn42_meta ]; then
    meta=$(cat /tmp/dn42_meta)
  else
    echo -e "\033[90mQuerying AkiLab node matrix...\033[0m"
    meta=$(api_get "/api/network-meta")
    echo "$meta" > /tmp/dn42_meta
  fi
  if ! echo "$meta" | grep -q '"success":true'; then
    echo -e "\033[31merror: Cannot fetch node list, try again later.\033[0m"
    return 1
  fi

  echo "$meta" | sed 's/},{/}\n{/g' | grep '"endpointDomain"' > /tmp/dn42_nodes_raw
  rm -f /tmp/dn42_nodes
  while IFS= read -r line; do
    nid=${line#*\"id\":\"}; nid=${nid%%\"*}
    nname=${line#*\"name\":\"}; nname=${nname%%\"*}
    nend=${line#*\"endpointDomain\":\"}; nend=${nend%%\"*}
    echo "$nid|$nname|$nend" >> /tmp/dn42_nodes
  done < /tmp/dn42_nodes_raw
  rm -f /tmp/dn42_nodes_raw
  return 0
}

do_new() {
  require_login || return 1

  local meta line node_idx i choice sel_node target_arg="$1"
  local clean_asn default_peer_port clean_tail default_lla
  local draft_file="/tmp/peer_draft"
  local template_file="/etc/peer_template"
  [ ! -f "$template_file" ] && template_file="${0%/*}/../etc/peer_template"
  [ ! -f "$template_file" ] && template_file="cli-src/etc/peer_template"

  ensure_nodes || return 1

  node_idx=0
  while IFS= read -r _; do node_idx=$((node_idx + 1)); done < /tmp/dn42_nodes
  if [ "$node_idx" -eq 0 ]; then
    echo -e "\033[31merror: Node list is empty.\033[0m"
    return 1
  fi

  # Select Node
  sel_nid=""
  sel_nname=""
  if [ -n "$target_arg" ]; then
    if echo "$target_arg" | grep -q '^[0-9][0-9]*$' && [ "$target_arg" -ge 1 ] && [ "$target_arg" -le "$node_idx" ]; then
      sel_line=$(sed -n "${target_arg}p" /tmp/dn42_nodes)
      sel_nid=${sel_line%%|*}
      sel_nname=${sel_line#*|}; sel_nname=${sel_nname%%|*}
    else
      # Match by node ID (case-insensitive)
      while IFS='|' read -r _nid _nname _nend; do
        if [ "$(echo "$_nid" | tr '[:upper:]' '[:lower:]')" = "$(echo "$target_arg" | tr '[:upper:]' '[:lower:]')" ]; then
          sel_nid="$_nid"
          sel_nname="$_nname"
          break
        fi
      done < /tmp/dn42_nodes
    fi
  fi

  if [ -z "$sel_nid" ]; then
    echo ""
    echo -e "\033[36m------ AKILAB DN42 PEERING WIZARD -----\033[0m"
    echo ""
    echo -e "Available Nodes:"
    i=0
    while IFS='|' read -r _nid _nname _nend; do
      i=$((i + 1))
      echo -e "  \033[32m[$i]\033[0m \033[1m$_nid\033[0m - $_nname"
    done < /tmp/dn42_nodes
    echo ""

    while true; do
      printf "Select target node \033[33m[1-%s]\033[0m: " "$i"
      read -r choice
      choice=$(echo "$choice" | tr -d ' \t\r\n')
      { [ "$choice" = "q" ] || [ "$choice" = "quit" ]; } && { echo -e "\033[90mCancelled.\033[0m"; return 0; }
      if echo "$choice" | grep -q '^[0-9][0-9]*$' && [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ]; then
        sel_line=$(sed -n "${choice}p" /tmp/dn42_nodes)
        sel_nid=${sel_line%%|*}
        sel_nname=${sel_line#*|}; sel_nname=${sel_nname%%|*}
        break
      else
        echo -e "\033[31merror: Invalid selection. Enter 1-$i or q to cancel.\033[0m"
      fi
    done
  fi

  # Check if user already has an existing session on target node
  sessions_resp=$(api_get "/api/sessions")
  existing_sess=$(echo "$sessions_resp" | sed 's/},{/}\n{/g' | grep "\"nodeId\":\"$sel_nid\"")
  if [ -n "$existing_sess" ]; then
    ex_id=${existing_sess#*\"id\":\"}; ex_id=${ex_id%%\"*}
    ex_port=${existing_sess#*\"hostPort\":}; ex_port=${ex_port%%,*}; ex_port=${ex_port%%\}*}
    ex_status=${existing_sess#*\"status\":\"}; ex_status=${ex_status%%\"*}
    echo ""
    echo -e "\033[33mNotice: An active session already exists on node $sel_nid (ID: $ex_id, Port: $ex_port, Status: $ex_status).\033[0m"
    printf "Submitting again will overwrite existing configuration. Continue? \033[33m[y/N]\033[0m: "
    read -r ex_confirm
    ex_confirm=$(echo "$ex_confirm" | tr 'A-Z' 'a-z' | tr -d ' \t\r\n')
    if [ "$ex_confirm" != "y" ] && [ "$ex_confirm" != "yes" ]; then
      echo -e "\033[90mCancelled.\033[0m"
      return 0
    fi
  fi

  clean_asn=$(cat /tmp/dn42_asn 2>/dev/null)
  if [ -z "$clean_asn" ]; then
    echo -e "\033[31merror: Session identity missing. Please logout and login again.\033[0m"
    return 1
  fi
  default_peer_port=$(calc_default_port "$clean_asn")
  [ -z "$default_peer_port" ] && default_peer_port=$((20000 + (clean_asn % 10000)))
  clean_tail=$((clean_asn % 10000))
  default_lla="fe80::$clean_tail"

  run_edit_flow "$sel_nid" "$sel_nname" "new"
}

# ---------- Shared editor flow (prefill via pfill_* globals) ----------
run_edit_flow() {
  sel_nid="$1"; sel_nname="$2"; action_mode="${3:-new}"

  draft_file="/tmp/peer_draft"
  template_file="/etc/peer_template"
  [ ! -f "$template_file" ] && template_file="${0%/*}/../etc/peer_template"
  [ ! -f "$template_file" ] && template_file="cli-src/etc/peer_template"

  # Template substitution with prefill values (defaults when empty)
  [ -z "$pfill_lla" ] && pfill_lla="$default_lla"
  [ -z "$pfill_peer_port" ] && pfill_peer_port="auto"
  [ -z "$pfill_listen_port" ] && pfill_listen_port="auto"
  [ -z "$pfill_mtu" ] && pfill_mtu="1420"

  cp -f "$template_file" "$draft_file"
  sed -i -e "s|__NODE__|$sel_nid|g" -e "s|__LLA__|$pfill_lla|g" -e "s|__IPV4__|$pfill_ipv4|g" -e "s|__ULA__|$pfill_ula|g" -e "s|__PUBKEY__|$pfill_pubkey|g" -e "s|__ENDPOINT__|$pfill_ep|g" -e "s|__PEER_PORT__|$pfill_peer_port|g" -e "s|__LISTEN_PORT__|$pfill_listen_port|g" -e "s|__MTU__|$pfill_mtu|g" -e "s|__ASN__|$clean_asn|g" -e "s|__DEFAULT_PORT__|$default_peer_port|g" "$draft_file"

  # Initial baseline values for untouched comparison
  init_node="$sel_nid"
  init_lla="$pfill_lla"
  init_ipv4="$pfill_ipv4"
  init_ula="$pfill_ula"
  init_pubkey="$pfill_pubkey"
  init_endpoint="$pfill_ep"
  init_peer_port="$pfill_peer_port"
  init_listen_port="$pfill_listen_port"
  init_mtu="$pfill_mtu"

  # Editor Interaction Loop
  while true; do
    # 1. Automatically launch editor (honors $EDITOR or defaults to nano)
    if [ -n "$EDITOR" ]; then
      $EDITOR "$draft_file"
    elif [ -x /bin/nano ]; then
      /bin/nano "$draft_file"
    elif [ -x /usr/bin/nano ]; then
      /usr/bin/nano "$draft_file"
    elif command -v nano >/dev/null 2>&1; then
      nano "$draft_file"
    else
      echo -e "\033[31merror: nano editor not found in system.\033[0m"
      return 1
    fi

    # 2. Parse draft key=value pairs + bare-value fallback (single awk pass, one fork)
    parsed_node=""
    parsed_lla=""
    parsed_ipv4=""
    parsed_ula=""
    parsed_pubkey=""
    parsed_ep=""
    parsed_peer_port="auto"
    parsed_listen_port="auto"
    parsed_mtu="1420"
    unknown_keys=""

    if [ ! -f "$draft_file" ]; then
      echo -e "\033[90mCancelled.\033[0m"
      return 0
    fi

    eval "$(awk '
      {
        line=$0; sub(/\r$/, "", line)
        if (line ~ /^[[:space:]]*#/ || line ~ /^[[:space:]]*$/) next
        if (index(line, "=") > 0) {
          key=substr(line, 1, index(line, "=")-1)
          val=substr(line, index(line, "=")+1)
          gsub(/[ \t]/, "", key)
          key=tolower(key)
          sub(/^[ \t]+/, "", val); sub(/[ \t]+$/, "", val)
          gsub(/[^A-Za-z0-9.:\/+_<>= -]/, "", val)
          if (key=="node") printf "parsed_node=\"%s\"\n", val
          else if (key=="link-localipv6(lla)" || key=="link-local" || key=="lla" || key=="linklocal") printf "parsed_lla=\"%s\"\n", val
          else if (key=="dn42ipv4(optional)" || key=="dn42ipv4" || key=="ipv4") printf "parsed_ipv4=\"%s\"\n", val
          else if (key=="ipv6ula(optional)" || key=="ipv6ula" || key=="ula") printf "parsed_ula=\"%s\"\n", val
          else if (key=="wireguardpublickey" || key=="publickey" || key=="pubkey") printf "parsed_pubkey=\"%s\"\n", val
          else if (key=="wireguardendpoint" || key=="endpoint") printf "parsed_ep=\"%s\"\n", val
          else if (key=="peerport" || key=="peer_port") { if (val!="") printf "parsed_peer_port=\"%s\"\n", val }
          else if (key=="listenport" || key=="listen_port") { if (val!="") printf "parsed_listen_port=\"%s\"\n", val }
          else if (key=="mtu") { if (val!="") printf "parsed_mtu=\"%s\"\n", val }
          else { if (unk=="") unk=key; else unk=unk ", " key }
        } else {
          bare=line; gsub(/[ \t]/, "", bare)
          if (bare=="") next
          if (bare ~ /^[fF][eE]80:[0-9a-fA-F:]+$/) printf "parsed_lla=\"%s\"\n", bare
          else if (bare ~ /^[A-Za-z0-9+\/]{43}=$/) printf "parsed_pubkey=\"%s\"\n", bare
          else if (bare ~ /^(172\.(2[0-3]|[0-9])\.|10\.)/) printf "parsed_ipv4=\"%s\"\n", bare
          else if (bare ~ /^[fF][dD][0-9a-fA-F:]+/) printf "parsed_ula=\"%s\"\n", bare
          else if (bare ~ /^[A-Za-z0-9.-]+$/) printf "parsed_ep=\"%s\"\n", bare
          else if (bare ~ /^[0-9]+$/) {
            if (bare+0>=1280 && bare+0<=1500) printf "parsed_mtu=\"%s\"\n", bare
            else { if (unk=="") unk="ambiguous port " bare; else unk=unk ", ambiguous port " bare }
          }
          else { if (unk=="") unk="unrecognized " bare; else unk=unk ", unrecognized " bare }
        }
      }
      END { if (unk!="") printf "unknown_keys=\"%s\"\n", unk }
    ' "$draft_file")"

    # 3. Content Comparison: if completely untouched baseline -> Cancelled
    if [ "$parsed_node" = "$init_node" ] && \
       [ "$parsed_lla" = "$init_lla" ] && \
       [ "$parsed_ipv4" = "$init_ipv4" ] && \
       [ "$parsed_ula" = "$init_ula" ] && \
       [ "$parsed_pubkey" = "$init_pubkey" ] && \
       [ "$parsed_ep" = "$init_endpoint" ] && \
       [ "$parsed_peer_port" = "$init_peer_port" ] && \
       [ "$parsed_listen_port" = "$init_listen_port" ] && \
       [ "$parsed_mtu" = "$init_mtu" ]; then
      echo -e "\033[90mCancelled.\033[0m"
      rm -f "$draft_file"
      return 0
    fi

    # 4. Batch Validation across all fields
    err_count=0
    err_msg_list=""

    # Node validation
    if [ -z "$parsed_node" ]; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • Node: Target PoP Node is required.\n"
    else
      node_found=0
      _parsed_lower=$(echo "$parsed_node" | tr '[:upper:]' '[:lower:]')
      while IFS='|' read -r _nid _nname _nend; do
        if [ "$(echo "$_nid" | tr '[:upper:]' '[:lower:]')" = "$_parsed_lower" ]; then
          node_found=1
          sel_nid="$_nid"
          sel_nname="$_nname"
          parsed_node="$_nid"
          break
        fi
      done < /tmp/dn42_nodes
      if [ "$node_found" -eq 0 ]; then
        err_count=$((err_count + 1))
        err_msg_list="${err_msg_list}  • Node: '$parsed_node' is not a valid AkiLab node.\n"
      fi
    fi

    # WireGuard Public Key (required)
    if [ -z "$parsed_pubkey" ]; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • WireGuard Public Key: Public key is required.\n"
    elif ! validate_pubkey "$parsed_pubkey"; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • WireGuard Public Key: Must be 44-character Base64 ending with =.\n"
    fi

    # Link-Local (required)
    if [ -z "$parsed_lla" ]; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • Link-Local: Link-Local address is required.\n"
    elif ! validate_link_local "$parsed_lla"; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • Link-Local: Must start with fe80: and be valid IPv6 (e.g. fe80::$clean_tail).\n"
    fi

    # IPv4 (optional)
    if [ -n "$parsed_ipv4" ] && ! validate_ipv4 "$parsed_ipv4"; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • DN42 IPv4: Must be within DN42 subnet (172.20.0.0/14 or 10.0.0.0/8).\n"
    fi

    # IPv6 ULA (optional)
    if [ -n "$parsed_ula" ] && ! validate_ipv6_ula "$parsed_ula"; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • IPv6 ULA: Must start with fd (e.g. fd00:4242:$clean_asn::1).\n"
    fi

    # Endpoint (optional)
    if [ -n "$parsed_ep" ] && ! validate_endpoint "$parsed_ep"; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • Endpoint: Must be a valid hostname or IP (no http:// or :port).\n"
    fi

    # PeerPort (AkiLab side listenPort)
    if [ "$parsed_peer_port" != "auto" ] && ! validate_port "$parsed_peer_port"; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • PeerPort: Port must be an integer between 20000 and 65535 or auto.\n"
    fi

    # ListenPort (Client side clientPort)
    if [ "$parsed_listen_port" != "auto" ] && ! validate_port "$parsed_listen_port"; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • ListenPort: Port must be an integer between 20000 and 65535 or auto.\n"
    fi

    # MTU
    if ! validate_mtu "$parsed_mtu"; then
      err_count=$((err_count + 1))
      err_msg_list="${err_msg_list}  • MTU: Must be between 1280 and 1500.\n"
    fi

    # 5. Handle Validation Outcome
    if [ -n "$unknown_keys" ]; then
      echo ""
      echo -e "\033[33mwarning: unrecognized field(s) ignored: $unknown_keys\033[0m"
      echo -e "\033[90m(Field names must match the template keys exactly.)\033[0m"
    fi

    if [ "$err_count" -gt 0 ]; then
      echo ""
      echo -e "\033[31mPeering configuration has $err_count error(s):\033[0m"
      printf "%b" "$err_msg_list"
      echo ""

      while true; do
        printf "Press \033[32mEnter\033[0m to edit again, \033[33mq\033[0m to cancel: "
        _ans=""
        read -r _ans
        _ans=$(echo "$_ans" | tr -d ' \t\r\n')
        case "$_ans" in
          ""|[eE]|[yY])
            # Reopen editor
            break
            ;;
          [qQ])
            echo -e "\033[90mCancelled.\033[0m"
            rm -f "$draft_file"
            return 0
            ;;
          *)
            echo -e "\033[31mInvalid option. Press Enter to edit or q to cancel.\033[0m"
            ;;
        esac
      done
      continue
    fi

    # 6. Review Summary Table
    [ "$parsed_peer_port" = "auto" ] && host_port_desc="assigned on submit..." || host_port_desc="$parsed_peer_port (fixed)"
    [ "$parsed_listen_port" = "auto" ] && client_port_desc="assigned on submit..." || client_port_desc="$parsed_listen_port (fixed)"

    echo ""
    printf "\033[36m%s\033[0m\n" "-------- REVIEW --------"
    echo -e "  Node             $sel_nid ($sel_nname)"
    echo -e "  LLA              $parsed_lla"
    [ -n "$parsed_ipv4" ] && echo -e "  IPv4             $parsed_ipv4"
    [ -n "$parsed_ula" ] && echo -e "  IPv6 ULA         $parsed_ula"
    echo -e "  WG PubKey        $parsed_pubkey"
    [ -n "$parsed_ep" ] && echo -e "  Endpoint         $parsed_ep"
    echo -e "  Peer ListenPort  $host_port_desc"
    echo -e "  Your ListenPort  $client_port_desc"
    echo -e "  MTU              $parsed_mtu"
    if [ "$parsed_peer_port" != "auto" ] || [ "$parsed_listen_port" != "auto" ]; then
      echo ""
      echo -e "\033[90mTip: Fixed port retains current value. Set to 'auto' in editor to re-enable auto conflict avoidance.\033[0m"
    fi
    echo ""

    while true; do
      printf "Confirm and submit? \033[33m[Y/n/q]\033[0m: "
      _confirm=""
      read -r _confirm
      _confirm=$(echo "$_confirm" | tr -d ' \t\r\n')
      case "$_confirm" in
        ""|[yY]|[yY][eE][sS])
          # Confirmed: Submit to backend
          break 2
          ;;
        [nN])
          # Return to editor
          break
          ;;
        [qQ])
          echo -e "\033[90mCancelled.\033[0m"
          rm -f "$draft_file"
          return 0
          ;;
        *)
          echo -e "\033[31mInvalid option. Enter y to submit, n to edit, q to cancel.\033[0m"
          ;;
      esac
    done
  done

  # 7. Construct and Submit Payload
  # Mapping: PeerPort -> listenPort (hostPort), ListenPort -> clientPort
  payload="{\"asn\":$clean_asn,\"nodeId\":\"$parsed_node\",\"publicKey\":\"$parsed_pubkey\",\"linkLocal\":\"$parsed_lla\",\"ipv4\":\"$parsed_ipv4\",\"ipv6Ula\":\"$parsed_ula\",\"endpoint\":\"$parsed_ep\",\"listenPort\":\"$parsed_peer_port\",\"clientPort\":\"$parsed_listen_port\",\"mtu\":$parsed_mtu,\"bgpMode\":\"mpbgp_enh\"}"

  echo ""
  echo -e "\033[90mSubmitting peering application to AkiLab Authority...\033[0m"
  resp=$(api_post "/api/peering/submit" "$payload")

  if ! echo "$resp" | grep -q '"success":true'; then
    echo -e "\033[31merror: $(json_field "$resp" message)\033[0m"
    return 1
  fi

  # Peering session successfully created: remove draft
  rm -f "$draft_file"

  sess_id=$(json_field "$resp" sessionId)
  is_shifted=$(json_bool "$resp" isShifted)
  conflict_msg=$(json_field "$resp" conflictMessage)
  wg_conf=$(json_field "$resp" clientWireguard)

  echo ""
  echo -e "\033[32m===============================================================================\033[0m"
  echo -e "\033[1;32mSession ID: $sess_id\033[0m"
  if [ "$is_shifted" = "true" ] && [ -n "$conflict_msg" ]; then
    echo -e "\033[33m[!] $conflict_msg\033[0m"
  fi
  is_client_shifted=$(json_bool "$resp" isClientPortShifted)
  client_port=$(json_field "$resp" clientPort)
  if [ "$is_client_shifted" = "true" ]; then
    echo -e "\033[33m[!] Default ListenPort 23143 is in use on this key, auto-shifted to $client_port\033[0m"
  fi
  echo ""
  if [ "$action_mode" = "update" ]; then
    echo -e "\033[36mPeering session updated successfully! Changes are applied.\033[0m"
  else
    echo -e "\033[36mReceived your peering info. We'll establish the peer with you within 24 hours!\033[0m"
  fi
  echo -e "\033[32m===============================================================================\033[0m"

  # Print Finished Configuration Products
  if [ -n "$wg_conf" ]; then
    echo ""
    echo -e "\033[36m── Client WireGuard Config example (reference only) ──\033[0m"
    echo -e "$wg_conf"
  fi
  echo ""
}

# ---------- peer edit ----------
do_edit() {
  require_login || return 1
  local resp line choice sel_line sel_id sel_nid rest target_idx="$1"
  local i sess_count full_line peer_block

  echo -e "\033[90mFetching your peering sessions...\033[0m"
  resp=$(api_get "/api/sessions")
  if ! echo "$resp" | grep -q '"success":true'; then
    echo -e "\033[31merror: $(json_field "$resp" message)\033[0m"
    return 1
  fi

  rm -f /tmp/dn42_my_sessions
  touch /tmp/dn42_my_sessions
  echo "$resp" | sed 's/},{/}\n{/g' | grep '"id"' | while IFS= read -r line; do
    _sid=${line#*\"id\":\"}; _sid=${_sid%%\"*}
    _snode=${line#*\"nodeId\":\"}; _snode=${_snode%%\"*}
    _sstat=${line#*\"status\":\"}; _sstat=${_sstat%%\"*}
    _sport=${line#*\"hostPort\":}; _sport=${_sport%%,*}; _sport=${_sport%%\}*}
    echo "$_sid|$_snode|$_sstat|$_sport" >> /tmp/dn42_my_sessions
  done

  sess_count=0
  while IFS= read -r _; do sess_count=$((sess_count + 1)); done < /tmp/dn42_my_sessions
  if [ "$sess_count" -eq 0 ]; then
    echo -e "\033[90mNo peering sessions yet. Run 'peer new' to create one.\033[0m"
    return 0
  fi

  sel_line=""
  if [ -n "$target_idx" ]; then
    if echo "$target_idx" | grep -q '^[0-9][0-9]*$' && [ "$target_idx" -ge 1 ] && [ "$target_idx" -le "$sess_count" ]; then
      sel_line=$(sed -n "${target_idx}p" /tmp/dn42_my_sessions)
    else
      # Match by node ID (case-insensitive) or session ID
      _tgt_lower=$(echo "$target_idx" | tr '[:upper:]' '[:lower:]')
      while IFS='|' read -r _sid _snode _sstat _sport; do
        if [ "$(echo "$_snode" | tr '[:upper:]' '[:lower:]')" = "$_tgt_lower" ] || \
           [ "$(echo "$_sid" | tr '[:upper:]' '[:lower:]')" = "$_tgt_lower" ]; then
          sel_line="$_sid|$_snode|$_sstat|$_sport"
          break
        fi
      done < /tmp/dn42_my_sessions
    fi

    if [ -z "$sel_line" ]; then
      echo -e "\033[31merror: Session '$target_idx' not found. Use 1-$sess_count, node ID (e.g. JP-7), or session ID.\033[0m"
      return 1
    fi
  else
    echo ""
    echo -e "\033[36m------ MY PEERING SESSIONS -----\033[0m"
    echo ""
    i=0
    while IFS='|' read -r _sid _snode _sstat _sport; do
      i=$((i + 1))
      echo -e "  \033[32m[$i]\033[0m $_snode - $_sstat - port $_sport"
    done < /tmp/dn42_my_sessions
    echo ""
    while true; do
      printf "Select session to edit \033[33m[1-%s]\033[0m: " "$i"
      read -r choice
      choice=$(echo "$choice" | tr -d ' \t\r\n')
      { [ "$choice" = "q" ] || [ "$choice" = "quit" ]; } && { echo -e "\033[90mCancelled.\033[0m"; return 0; }
      if echo "$choice" | grep -q '^[0-9][0-9]*$' && [ "$choice" -ge 1 ] && [ "$choice" -le "$i" ]; then
        sel_line=$(sed -n "${choice}p" /tmp/dn42_my_sessions)
        break
      else
        echo -e "\033[31merror: Invalid selection. Enter 1-$i or q to cancel.\033[0m"
      fi
    done
  fi

  sel_id=${sel_line%%|*}
  rest=${sel_line#*|}; sel_nid=${rest%%|*}

  # Extract this session's peering block for prefill
  full_line=$(echo "$resp" | sed 's/},{/}\n{/g' | grep "\"id\":\"$sel_id\"")
  peer_block=$(echo "$full_line" | sed 's/.*"peering":{//; s/},"assigned".*//')

  pfill_pubkey=$(echo "$peer_block" | sed -n 's/.*"publicKey":"\([^"]*\)".*/\1/p')
  pfill_ep=$(echo "$peer_block" | sed -n 's/.*"endpoint":"\([^"]*\)".*/\1/p')
  pfill_ipv4=$(echo "$peer_block" | sed -n 's/.*"ipv4":"\([^"]*\)".*/\1/p')
  pfill_ula=$(echo "$peer_block" | sed -n 's/.*"ipv6Ula":"\([^"]*\)".*/\1/p')
  pfill_lla=$(echo "$peer_block" | sed -n 's/.*"linkLocal":"\([^"]*\)".*/\1/p')
  pfill_peer_port=$(echo "$peer_block" | sed -n 's/.*"listenPort":"\([^"]*\)".*/\1/p')
  [ -z "$pfill_peer_port" ] && pfill_peer_port=$(echo "$peer_block" | sed -n 's/.*"listenPort":\([0-9]*\).*/\1/p')
  [ -z "$pfill_peer_port" ] && pfill_peer_port="auto"
  pfill_listen_port=$(echo "$peer_block" | sed -n 's/.*"clientPort":"\([^"]*\)".*/\1/p')
  [ -z "$pfill_listen_port" ] && pfill_listen_port=$(echo "$peer_block" | sed -n 's/.*"clientPort":\([0-9]*\).*/\1/p')
  [ -z "$pfill_listen_port" ] && pfill_listen_port="auto"
  pfill_mtu=$(echo "$peer_block" | sed -n 's/.*"mtu":\([0-9]*\).*/\1/p')
  [ -z "$pfill_mtu" ] && pfill_mtu="1420"

  clean_asn=$(dn42_asn 2>/dev/null)
  [ -z "$clean_asn" ] && clean_asn=$(cat /tmp/dn42_asn 2>/dev/null)
  if [ -z "$clean_asn" ]; then
    echo -e "\033[31merror: Session identity missing. Please logout and login again.\033[0m"
    return 1
  fi
  default_peer_port=$(calc_default_port "$clean_asn")
  [ -z "$default_peer_port" ] && default_peer_port=$((20000 + (clean_asn % 10000)))
  clean_tail=$((clean_asn % 10000))
  default_lla="fe80::$clean_tail"

  ensure_nodes || return 1

  # Resolve node display name
  sel_nname=""
  while IFS='|' read -r _nid _nname _nend; do
    if [ "$_nid" = "$sel_nid" ]; then
      sel_nname="$_nname"
      break
    fi
  done < /tmp/dn42_nodes

  echo ""
  echo -e "\033[90mEditing session on $sel_nid - prefill loaded. Make your changes, then Ctrl+S save, Ctrl+X exit.\033[0m"

  run_edit_flow "$sel_nid" "$sel_nname" "update"
}

# ---------- peer ls ----------
do_ls() {
  require_login || return 1
  local resp line id asn node status port stage
  echo -e "\033[90mFetching peering sessions...\033[0m"
  resp=$(api_get "/api/sessions")
  if ! echo "$resp" | grep -q '"success":true'; then
    echo -e "\033[31merror: $(json_field "$resp" message)\033[0m"
    return 1
  fi

  echo ""
  printf "%-28s %-12s %-12s %-8s %s\n" "SESSION ID" "ASN" "NODE" "PORT" "STATUS"
  printf "\033[90m-------------------------------------------------------------------------------\033[0m\n"

  echo "$resp" | sed 's/},{/}\n{/g' | grep '"id"' | while IFS= read -r line; do
    id=${line#*\"id\":\"}; id=${id%%\"*}
    asn=${line#*\"asn\":}; asn=${asn%%,*}; asn=${asn%%\}*}
    node=${line#*\"nodeId\":\"}; node=${node%%\"*}
    port=${line#*\"hostPort\":}; port=${port%%,*}; port=${port%%\}*}
    status=${line#*\"status\":\"}; status=${status%%\"*}
    stage=${line#*\"stageText\":\"}; [ "$stage" = "$line" ] && stage="$status"; stage=${stage%%\"*}

    # Colorize status based on transparent BGP state
    color="\033[0m"
    case "$stage" in
      *Established*|*active*)
        color="\033[1;32m" ;;
      *Connect*|*Active*)
        color="\033[1;33m" ;;
      *Idle*)
        color="\033[1;36m" ;;
      *)
        color="\033[90m" ;;
    esac

    printf "%-28s %-12s %-12s %-8s %b%s\033[0m\n" "$id" "AS$asn" "$node" "$port" "$color" "$stage"
  done
  echo ""
  echo -e "\033[90mTip: Run 'peer edit' to update an existing session; 'peer new' for a new one.\033[0m"
  echo ""
}

# ---------- peer rm ----------
do_rm() {
  require_login || return 1
  local target_id="$1"
  if [ -z "$target_id" ]; then
    echo -e "\033[31merror: Session ID is required. Usage: peer rm <SESSION_ID>\033[0m"
    return 1
  fi

  echo -e "\033[90mRevoking session $target_id and releasing port...\033[0m"
  resp=$(api_post "/api/sessions/remove" "{\"sessionId\":\"$target_id\"}")
  if echo "$resp" | grep -q '"success":true'; then
    echo -e "\033[32mSession $target_id revoked successfully.\033[0m"
  else
    err_msg=$(json_field "$resp" message)
    [ -z "$err_msg" ] && err_msg="Failed to revoke session"
    echo -e "\033[31merror: $err_msg\033[0m"
  fi
}

case "$1" in
  new) do_new "$2" ;;
  edit) do_edit "$2" ;;
  ls|list) do_ls ;;
  rm|remove|delete) do_rm "$2" ;;
  *) usage ;;
esac
