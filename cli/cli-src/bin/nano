#!/bin/busybox sh
# ==============================================================================
# AkiLab Editor — lightweight full-screen editor for DN42 WASM Linux
# (batch input buffering + incremental redraw; no GNU nano impersonation)
# ==============================================================================

FILE="$1"
if [ -z "$FILE" ]; then
  echo "Usage: editor <filename>"
  exit 1
fi

# ---- terminal setup (once) ----
ROWS=24; COLS=80
if [ -t 0 ] 2>/dev/null; then :; fi
_sz="$(stty size 2>/dev/null)"
if [ -n "$_sz" ]; then
  ROWS="${_sz%% *}"; COLS="${_sz##* }"
fi
[ "$ROWS" -lt 6 ] && ROWS=24
[ "$COLS" -lt 20 ] && COLS=80
EDIT_ROWS=$((ROWS - 4))

cleanup() {
  printf "\033[?1049l\033[?25h"
  stty sane 2>/dev/null
  exit ${1:-0}
}
trap 'cleanup 0' EXIT
trap 'cleanup 1' INT TERM

printf "\033[?1049h\033[2J\033[H"
stty -echo -icanon -isig -ixon -ixoff min 1 time 0 2>/dev/null || stty raw -echo 2>/dev/null

# ---- load file ----
NUM_LINES=0
if [ -f "$FILE" ]; then
  while IFS= read -r _line || [ -n "$_line" ]; do
    _line="$(printf '%s' "$_line" | tr -d '\r')"
    eval "L_$NUM_LINES=\"\$_line\""
    NUM_LINES=$((NUM_LINES + 1))
  done < "$FILE"
fi
if [ "$NUM_LINES" -eq 0 ]; then
  eval "L_0=''"
  NUM_LINES=1
fi

CUR_ROW=0; CUR_COL=0; TOP_LINE=0; LEFT_COL=0; MODIFIED=0
STATUS_MSG="[ Read $NUM_LINES lines ]"

CTRL_O="$(printf '\017')"
CTRL_S="$(printf '\023')"
CTRL_X="$(printf '\030')"
CTRL_Q="$(printf '\021')"
CTRL_C="$(printf '\003')"
ESC="$(printf '\033')"
ENTER="$(printf '\n')"
CR="$(printf '\r')"
BS1="$(printf '\177')"
BS2="$(printf '\b')"

# ---- rendering (incremental) ----
# redraw_line <row-index>  : repaint one content line at its screen position
redraw_line() {
  _r="$1"
  [ "$_r" -lt "$TOP_LINE" ] && return
  [ "$_r" -ge $((TOP_LINE + EDIT_ROWS)) ] && return
  _srow=$((_r - TOP_LINE + 2))
  eval "_txt=\$L_$_r"
  printf "\033[%d;1H%s\033[K" "$_srow" "$_txt"
}

# redraw_status : repaint status bar only
redraw_status() {
  printf "\033[%d;1H\033[K" $((ROWS - 2))
  if [ -n "$STATUS_MSG" ]; then
    printf "\033[%d;1H%s" $((ROWS - 2)) "$STATUS_MSG"
  fi
  printf "\033[%d;1H\033[7m%s\033[0m\033[K" $((ROWS - 1)) " ^O WriteOut  ^X Exit"
}

# full_draw : complete screen (title + all lines + bars) — single batched write
full_draw() {
  _out=""
  _mod_str=""
  [ "$MODIFIED" -eq 1 ] && _mod_str=" [Modified]"
  _out="${_out}\033[H\033[7m AkiLab Editor 1.0 File: ${FILE}${_mod_str}\033[0m\033[K\n"
  _r=0
  while [ "$_r" -lt "$EDIT_ROWS" ]; do
    _li=$((TOP_LINE + _r))
    _srow=$((_r + 2))
    if [ "$_li" -lt "$NUM_LINES" ]; then
      eval "_t=\$L_$_li"
      _disp="${_t:$LEFT_COL:$COLS}"
      _out="${_out}\033[${_srow};1H${_disp}\033[K\n"
    else
      _out="${_out}\033[${_srow};1H~\033[K\n"
    fi
    _r=$((_r + 1))
  done
  _out="${_out}\033[$((ROWS - 2));1H\033[K"
  [ -n "$STATUS_MSG" ] && _out="${_out}\033[$((ROWS - 2));1H${STATUS_MSG}"
  _out="${_out}\033[$((ROWS - 1));1H\033[7m ^O WriteOut  ^X Exit\033[0m\033[K"
  printf '%b' "$_out"
}

# position_cursor : move terminal cursor to (CUR_ROW, CUR_COL)
position_cursor() {
  _srow=$((CUR_ROW - TOP_LINE + 2))
  _scol=$((CUR_COL - LEFT_COL + 1))
  printf "\033[%d;%dH\033[?25h" "$_srow" "$_scol"
}

# adjust_viewport : keep cursor in visible area (no stty call — cached size)
adjust_viewport() {
  if [ "$CUR_ROW" -lt "$TOP_LINE" ]; then
    TOP_LINE="$CUR_ROW"
  elif [ "$CUR_ROW" -ge $((TOP_LINE + EDIT_ROWS)) ]; then
    TOP_LINE=$((CUR_ROW - EDIT_ROWS + 1))
  fi
  if [ "$CUR_COL" -lt "$LEFT_COL" ]; then
    LEFT_COL="$CUR_COL"
  elif [ "$CUR_COL" -ge $((LEFT_COL + COLS - 4)) ]; then
    LEFT_COL=$((CUR_COL - COLS + 5))
  fi
}

# save_file — batched single write
save_file() {
  _tmp_out="${FILE}.tmp.$$"
  _i=0
  _buf=""
  while [ "$_i" -lt "$NUM_LINES" ]; do
    eval "_l=\$L_$_i"
    _buf="${_buf}${_l}\n"
    _i=$((_i + 1))
  done
  printf '%b' "$_buf" > "$_tmp_out"
  mv -f "$_tmp_out" "$FILE"
  MODIFIED=0
  STATUS_MSG="[ Wrote $NUM_LINES lines ]"
}

# insert_text <text> : insert at cursor, repaint current line
insert_text() {
  _ins="$1"
  [ -z "$_ins" ] && return
  eval "_ct=\$L_$CUR_ROW"
  _before="${_ct:0:$CUR_COL}"
  _after="${_ct:$CUR_COL}"
  eval "L_$CUR_ROW=\"\${_before}\${_ins}\${_after}\""
  CUR_COL=$((CUR_COL + ${#_ins}))
  MODIFIED=1
  redraw_line "$CUR_ROW"
}

# backspace at cursor
do_backspace() {
  eval "_ct=\$L_$CUR_ROW"
  if [ "$CUR_COL" -gt 0 ]; then
    _before="${_ct:0:$((CUR_COL - 1))}"
    _after="${_ct:$CUR_COL}"
    eval "L_$CUR_ROW=\"\${_before}\${_after}\""
    CUR_COL=$((CUR_COL - 1))
    MODIFIED=1
    redraw_line "$CUR_ROW"
  elif [ "$CUR_ROW" -gt 0 ]; then
    # merge with previous line
    _pr=$((CUR_ROW - 1))
    eval "_pt=\$L_$_pr"
    _plen=${#_pt}
    eval "L_$_pr=\"\${_pt}\${_ct}\""
    _j=$CUR_ROW
    while [ "$_j" -lt $((NUM_LINES - 1)) ]; do
      eval "L_$_j=\$L_$((_j + 1))"
      _j=$((_j + 1))
    done
    eval "unset L_$((NUM_LINES - 1))"
    NUM_LINES=$((NUM_LINES - 1))
    CUR_ROW="$_pr"
    CUR_COL="$_plen"
    MODIFIED=1
    full_draw
  fi
}

# enter at cursor: split line
do_enter() {
  eval "_ct=\$L_$CUR_ROW"
  _left="${_ct:0:$CUR_COL}"
  _right="${_ct:$CUR_COL}"
  _j=$NUM_LINES
  while [ "$_j" -gt $((CUR_ROW + 1)) ]; do
    eval "L_$_j=\$L_$((_j - 1))"
    _j=$((_j - 1))
  done
  eval "L_$CUR_ROW=\"\$_left\""
  eval "L_$((CUR_ROW + 1))=\"\$_right\""
  NUM_LINES=$((NUM_LINES + 1))
  CUR_ROW=$((CUR_ROW + 1))
  CUR_COL=0
  MODIFIED=1
  full_draw
}

# delete key at cursor
do_delete() {
  eval "_ct=\$L_$CUR_ROW"
  _len=${#_ct}
  if [ "$CUR_COL" -lt "$_len" ]; then
    _before="${_ct:0:$CUR_COL}"
    _after="${_ct:$((CUR_COL + 1))}"
    eval "L_$CUR_ROW=\"\${_before}\${_after}\""
    MODIFIED=1
    redraw_line "$CUR_ROW"
  elif [ "$CUR_ROW" -lt $((NUM_LINES - 1)) ]; then
    _nr=$((CUR_ROW + 1))
    eval "_nt=\$L_$_nr"
    eval "L_$CUR_ROW=\"\${_ct}\${_nt}\""
    _j=$_nr
    while [ "$_j" -lt $((NUM_LINES - 1)) ]; do
      eval "L_$_j=\$L_$((_j + 1))"
      _j=$((_j + 1))
    done
    eval "unset L_$((NUM_LINES - 1))"
    NUM_LINES=$((NUM_LINES - 1))
    MODIFIED=1
    full_draw
  fi
}

# ---- startup ----
full_draw
position_cursor

# ---- main loop (batch buffered) ----
while true; do
  _c=""
  IFS= read -r -n 1 _c || { cleanup 0; }

  # --- fast-path: batch-drain pending input into one insert (paste friendly) ---
  _is_print=0
  case "$_c" in
    [\ -~]) _is_print=1 ;;  # ASCII printable
  esac
  if [ "$_is_print" -eq 1 ]; then
    _buf="$_c"
    while IFS= read -r -n 1 -t 0 _more 2>/dev/null; do
      case "$_more" in
        [\ -~]) _buf="$_buf$_more" ;;
        *) break ;;
      esac
    done
    insert_text "$_buf"
    adjust_viewport
    position_cursor
    continue
  fi

  # --- control keys ---
  _code=0
  [ -n "$_c" ] && _code=$(printf '%d' "'$_c" 2>/dev/null || echo 0)

  case "$_c" in

  "$CTRL_X"|"$CTRL_Q")
    if [ "$MODIFIED" -eq 1 ]; then
      STATUS_MSG="Save modified buffer? (Y/N/C)  — answering N will DISCARD changes"
      redraw_status
      _ans=""
      while true; do
        IFS= read -r -n 1 _ans || { cleanup 0; }
        case "$_ans" in
          [yY]) save_file; cleanup 0 ;;
          [nN]) cleanup 0 ;;
          "$CTRL_C") STATUS_MSG="Cancelled" ; break ;;
          *) STATUS_MSG="Save modified buffer? (Y/N/C)" ; redraw_status ;;
        esac
      done
      redraw_status
    else
      cleanup 0
    fi
    ;;

  "$CTRL_O"|"$CTRL_S")
    save_file
    redraw_status
    ;;

  "$CTRL_C")
    # no default binding (matches GNU nano: ^C only cancels secondary prompts)
    :
    ;;

  "$ENTER"|"$CR")
    do_enter
    adjust_viewport
    position_cursor
    ;;

  "$BS1"|"$BS2")
    do_backspace
    adjust_viewport
    position_cursor
    ;;

  "$ESC")
    _c2=""
    IFS= read -r -n 1 -t 0.05 _c2 2>/dev/null
    if [ -z "$_c2" ]; then
      # lone ESC: ignore silently (no stall)
      continue
    fi
    _c3=""
    if [ "$_c2" = "[" ] || [ "$_c2" = "O" ]; then
      IFS= read -r -n 1 -t 0.05 _c3 2>/dev/null
      _c4=""
      case "$_c3" in
        1|3|4|5|6|7|8) IFS= read -r -n 1 -t 0.05 _c4 2>/dev/null ;;
      esac
      _seq="$_c2$_c3$_c4"
    else
      _seq="$_c2"
    fi
    case "$_seq" in
      "[A"|"OA")
        if [ "$CUR_ROW" -gt 0 ]; then
          CUR_ROW=$((CUR_ROW - 1))
          eval "_l=\${#L_$CUR_ROW}"
          [ "$CUR_COL" -gt "$_l" ] && CUR_COL="$_l"
        fi
        ;;
      "[B"|"OB")
        if [ "$CUR_ROW" -lt $((NUM_LINES - 1)) ]; then
          CUR_ROW=$((CUR_ROW + 1))
          eval "_l=\${#L_$CUR_ROW}"
          [ "$CUR_COL" -gt "$_l" ] && CUR_COL="$_l"
        fi
        ;;
      "[C"|"OC")
        eval "_l=\${#L_$CUR_ROW}"
        if [ "$CUR_COL" -lt "$_l" ]; then
          CUR_COL=$((CUR_COL + 1))
        elif [ "$CUR_ROW" -lt $((NUM_LINES - 1)) ]; then
          CUR_ROW=$((CUR_ROW + 1)); CUR_COL=0
        fi
        ;;
      "[D"|"OD")
        if [ "$CUR_COL" -gt 0 ]; then
          CUR_COL=$((CUR_COL - 1))
        elif [ "$CUR_ROW" -gt 0 ]; then
          CUR_ROW=$((CUR_ROW - 1))
          eval "_l=\${#L_$CUR_ROW}"
          CUR_COL="$_l"
        fi
        ;;
      "[H"|"[1~"|"OH") CUR_COL=0 ;;
      "[F"|"[4~"|"OF")
        eval "_l=\${#L_$CUR_ROW}"
        CUR_COL="$_l"
        ;;
      "[3~") do_delete ;;
    esac
    adjust_viewport
    position_cursor
    ;;

  esac
done
