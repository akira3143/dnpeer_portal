#!/bin/busybox sh
# passwd —— 修改登录密码（须先通过 SSH 签名认证，对齐 POST /api/auth/set-password）

. /etc/dn42-lib.sh

target_asn=$(dn42_asn | tr -cd '0-9')
token=$(dn42_token)

if [ -z "$target_asn" ] || [ -z "$token" ]; then
  echo -e "\033[31merror: please login first.\033[0m"
  exit 1
fi

echo -e "\033[90mVerifying identity via SSH signature before changing password...\033[0m"

# ---- SSH challenge 认证（与登录同源流程） ----
resp=$(api_post "/api/auth/challenge" "{\"asn\":\"$target_asn\"}")
if ! echo "$resp" | grep -q '"success":true'; then
  echo -e "\033[31merror: $(json_field "$resp" error)\033[0m"
  exit 1
fi

chal_text=$(json_field "$resp" challengeText)
unix_cmd=$(echo "$resp" | sed -n 's/.*"unixCommand":"\(.*\)","powershellCommand.*/\1/p' | sed 's/\\"/"/g; s/\\\\/\\/g')
ps_cmd=$(echo "$resp" | sed -n 's/.*"powershellCommand":"\(.*\)"\}.*/\1/p' | sed 's/\\"/"/g; s/\\\\/\\/g')

echo ""
echo -e "\033[90mChallenge: \033[33m$chal_text\033[0m"
echo -e "\033[90mRun ONE of the commands below on YOUR OWN machine (not in this terminal).\033[0m"
echo ""
if [ -n "$ps_cmd" ]; then
  echo -e "\033[1m[Windows / PowerShell]\033[0m"
  printf '  %s\n' "$ps_cmd"
  echo ""
fi
if [ -n "$unix_cmd" ]; then
  echo -e "\033[1m[Linux / macOS / Git Bash]\033[0m"
  printf '  %s\n' "$unix_cmd"
  echo ""
fi
echo -e "\033[90mIf your key is not at the default path, edit the -f argument above.\033[0m"

sig=""
while true; do
  printf "\033[33msignature\033[0m: "
  sig=""
  while true; do
    if ! read -r -t 3 line; then
      if [ -n "$sig" ]; then break; fi
      continue
    fi
    [ -z "$line" ] && continue
    if [ -z "$sig" ] && { [ "$line" = "q" ] || [ "$line" = "quit" ] || [ "$line" = "abort" ]; }; then
      echo -e "\033[90mCancelled.\033[0m"
      exit 1
    fi
    line=$(printf '%s' "$line" | tr -d '\r')
    if [ -z "$sig" ]; then
      sig="$line"
    else
      sig="$sig\\n$line"
    fi
    if echo "$line" | grep -q -- "END SSH SIGNATURE"; then
      break
    fi
  done

  if [ -z "$sig" ]; then
    echo -e "\033[31merror: signature cannot be empty.\033[0m"
    continue
  fi

  echo -e "\033[90mVerifying cryptographic signature with gateway...\033[0m"
  resp=$(api_post "/api/auth/verify-ssh" "{\"asn\":\"$target_asn\",\"signature\":\"$sig\",\"rememberMe\":false}")
  if echo "$resp" | grep -q '"success":true'; then
    break
  fi
  echo -e "\033[31merror: $(json_field "$resp" error)\033[0m"
done

echo -e "\033[32mIdentity verified.\033[0m"
echo ""

# ---- 修改密码 ----
printf "\033[33mNew password (8+ chars):\033[0m "
stty -echo 2>/dev/null; read -r p1; stty echo 2>/dev/null; echo ""
printf "\033[33mConfirm new password:\033[0m "
stty -echo 2>/dev/null; read -r p2; stty echo 2>/dev/null; echo ""

if [ "${#p1}" -lt 8 ]; then
  echo -e "\033[31merror: password must be at least 8 characters.\033[0m"
  exit 1
fi
if [ "$p1" != "$p2" ]; then
  echo -e "\033[31merror: passwords do not match.\033[0m"
  exit 1
fi

resp=$(wget -q -T 15 -O - --post-data="{\"asn\":\"$target_asn\",\"password\":\"$p1\"}" --header="Content-Type: application/json" --header="Authorization: Bearer $token" "$API_BASE/api/auth/set-password" 2>/dev/null)
if echo "$resp" | grep -q '"success":true'; then
  echo -e "\033[32mPassword updated.\033[0m"
else
  echo -e "\033[31merror: $(json_field "$resp" error)\033[0m"
  exit 1
fi
