#!/bin/busybox sh
# whoami —— Current identity (aligned with GET /api/auth/me)

if [ -f /etc/dn42-lib.sh ]; then
  . /etc/dn42-lib.sh
elif [ -f "${0%/*}/../etc/dn42-lib.sh" ]; then
  . "${0%/*}/../etc/dn42-lib.sh"
elif [ -f "cli-src/etc/dn42-lib.sh" ]; then
  . "cli-src/etc/dn42-lib.sh"
fi

token=$(dn42_token)
if [ -z "$token" ]; then
  echo -e "\033[33mUnauthenticated guest session.\033[0m"
  exit 0
fi

resp=$(api_get "/api/auth/me")
if ! echo "$resp" | grep -q '"success":true'; then
  echo -e "\033[31merror: Token invalid, please login again.\033[0m"
  exit 1
fi

asn=$(json_field "$resp" asn)
as_name=$(json_field "$resp" asName)
role=$(json_field "$resp" role)

echo -e "\033[1mActive DN42 Session:\033[0m"
echo -e "  ASN:        \033[92mAS${asn:-$(dn42_asn)}\033[0m"
[ -n "$as_name" ] && echo -e "  Name:       \033[36m$as_name\033[0m"
echo -e "  Role:       \033[35m${role:-user}\033[0m"
echo -e "  Status:     \033[32mAuthenticated (JWT)\033[0m"
