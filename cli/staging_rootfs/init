#!/bin/busybox sh
# init —— PID 1 引导中枢（WASM Linux）

/bin/busybox --install -s 2>/dev/null

/bin/busybox mkdir -p /dev /proc /sys /tmp /root /mnt /mnt/host /mnt/persist
/bin/busybox chmod 1777 /tmp
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mkdir -p /dev/pts
/bin/busybox mount -t devpts devpts /dev/pts
hostname as4242423143
export TZ=CST-8
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root

# 持久层：浏览器 OPFS 通过 virtio-fs 挂载（tag=persist）
# 挂载失败不影响主流程（rememberMe 自动登录静默降级）
mount -t virtiofs persist /mnt/persist 2>/dev/null
mkdir -p /mnt/persist/.dn42 2>/dev/null

ip link set lo up 2>/dev/null
ifc=$(ls /sys/class/net 2>/dev/null | grep -v '^lo$' | head -n1)
if [ -n "$ifc" ]; then
  ip link set "$ifc" up
  ip addr add 10.0.2.15/24 dev "$ifc"
  ip route add default via 10.0.2.2 dev "$ifc"
  echo "nameserver 10.0.2.2" > /etc/resolv.conf
fi

cd /root
while true; do
  /bin/busybox cttyhack /sbin/dn42-login </dev/hvc0 >/dev/hvc0 2>&1
  sleep 1
done
