# Server Environment Configuration
NODE_ENV=production
PORT=4242
HOST=127.0.0.1

# Security & Authentication
AUTH_JWT_SECRET=your_ultra_secure_random_jwt_secret_at_least_32_chars_long

# Email OTP Authentication (Optional, powered by Resend: https://resend.com)
# When configured, peers can sign in using a 6-digit one-time passcode sent to their DN42 WHOIS email.
RESEND_API_KEY=
RESEND_FROM=AkiLab Networks <auth@akilab.meme>

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Periodic DN42 Registry Git Sync (Optional, in milliseconds, default: 600000 = 10 mins)
# REGISTRY_SYNC_INTERVAL_MS=600000

# Public Domain / Master URL (Optional, for CLI & Probe auto-discovery)
# PORTAL_DOMAIN=dn42.akilab.meme
# PORTAL_MASTER_URL=https://dn42.akilab.meme

# Data Directories (Optional override)
# PORTAL_DATA_DIR=/var/lib/dn42-portal/data
# PORTAL_CONFIG_PATH=/opt/dn42-portal/portal.config.yaml
