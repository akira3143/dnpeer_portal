# Server Environment Configuration
NODE_ENV=production
PORT=4242
HOST=127.0.0.1

# Security & Authentication
AUTH_JWT_SECRET=your_ultra_secure_random_jwt_secret_at_least_32_chars_long

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

